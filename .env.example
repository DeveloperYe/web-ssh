# 部署配置模板
#   · Docker Compose：复制为同目录 .env，docker compose up 会自动加载
#   · Docker run：     docker run --env-file .env -p 3000:3000 web-ssh
#   · Node 直接跑：    参考 server.js 注释，把下面值 export 到环境变量即可
# 未设置的项都保持关闭（安全默认），用到哪个再填哪个。

# 监听
PORT=3000

# ---- 网页终端 ----
# 公开访问强烈建议开启（先配 HTTPS）
# SSH_WEB_USER=admin
# SSH_WEB_PASS=换成强密码

# ---- AI / 脚本 API（Bearer Token） ----
# 设置后 /api/exec 才可用；AI 调用时带 Authorization: Bearer <此值>
# 保持为空则 API 关闭（安全默认）。用前务必填一个随机强令牌，勿用示例值。
SSH_API_TOKEN=

# ---- 服务端默认 SSH 凭据（API 执行命令时的目标，AI 不用传） ----
# 「操作 VM 自身」场景：AI 命令落在本机，故指向 127.0.0.1，
# 用户名、密码用 web-ssh 运行用户在同一台 VM 的 SSH 账号（见 README「VM 部署」装 sshd）。
# 若要操作的是另一台服务器，把 HOST/USER 改成那台即可。
SSH_DEFAULT_HOST=127.0.0.1
SSH_DEFAULT_PORT=22
SSH_DEFAULT_USER=deploy
SSH_DEFAULT_PASSWORD=换成你的登录密码
# 或用私钥（二选一：文件路径 或 文本）
# SSH_DEFAULT_PRIVATE_KEY_PATH=/home/deploy/.ssh/id_ed25519
# SSH_DEFAULT_PRIVATE_KEY=-----BEGIN OPENSSH PRIVATE KEY-----...